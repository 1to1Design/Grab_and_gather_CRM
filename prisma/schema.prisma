// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Vertical {
  GYM_FITNESS
  URGENT_CARE_MEDICAL
  COWORKING_OFFICE
  APARTMENT_COMPLEX
  WAREHOUSE_MANUFACTURING
  SCHOOL_DISTRICT
  DEALERSHIP
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP_NEEDED
  MEETING_SCHEDULED
  PLACED_WON
  PASSED
  LOST
}

// Ordered worst-to-best on purpose: Postgres enum comparisons follow
// declaration order, so `orderBy: { leadQuality: 'desc' }` naturally
// surfaces the most promising leads first.
enum LeadQuality {
  UNRATED
  BELOW_THRESHOLD
  QUALIFIED
  HIGH_VOLUME
  MEGA_TRAFFIC
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  leads             Lead[]
  leadNotes         LeadNote[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Lead {
  id String @id @default(cuid())

  organizationName String
  vertical         Vertical
  contactName      String?
  contactTitle     String?
  phone            String?
  email            String?
  address          String?

  status      LeadStatus  @default(NEW)
  leadQuality LeadQuality @default(UNRATED)

  notes LeadNote[]

  nextFollowUpDate DateTime?
  dateLogged       DateTime  @default(now())
  lastContactedAt  DateTime?

  footTrafficNotes String? @db.Text

  financialModelUrl     String?
  placementAgreementUrl String?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vertical])
  @@index([nextFollowUpDate])
  @@index([lastContactedAt])
  @@index([leadQuality])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@index([leadId])
  @@map("lead_notes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("push_subscriptions")
}
